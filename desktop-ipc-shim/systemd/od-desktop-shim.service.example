[Unit]
Description=OpenDesign desktop IPC shim (Chrome headless render-slides)
Documentation=https://github.com/nexu-io/open-design
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Placeholders — replaced when installing (see README):
#   @SHIM_ROOT@  absolute path to desktop-ipc-shim
#   @OD_ROOT@    absolute path to OpenDesign checkout
#   @NODE_BIN@   absolute path to node (≥22)
#   @CHROME_BIN@ Chrome/Chromium binary
WorkingDirectory=@SHIM_ROOT@
Environment=OD_OPEN_DESIGN_ROOT=@OD_ROOT@
Environment=OD_SIDECAR_NAMESPACE=default
Environment=OD_BROWSER_EXECUTABLE_PATH=@CHROME_BIN@
Environment=OD_SHIM_KEEP_BROWSER=1
ExecStart=@NODE_BIN@ --import tsx src/main.ts --keep-browser --open-design-root @OD_ROOT@
Restart=on-failure
RestartSec=3
MemoryMax=1536M

[Install]
WantedBy=multi-user.target
